{
  "name": "symphoneer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "check": "pnpm check:format && pnpm check:types && pnpm check:project && pnpm test && pnpm check:web",
    "check:format": "biome check .",
    "check:project": "node scripts/check-project.mjs",
    "check:types": "tsc --noEmit && pnpm check:types:web",
    "check:types:web": "tsc -p src/web/tsconfig.json --noEmit",
    "check:web": "pnpm run web:build",
    "dev": "node scripts/dev.ts",
    "runtime:cli": "node src/cli/runtime.ts",
    "runtime:dev": "node --watch src/runtime/serve.ts",
    "runtime:serve": "node src/runtime/serve.ts",
    "smoke:assistant": "node scripts/assistant-smoke.ts",
    "smoke:claude-code": "node scripts/claude-code-smoke.ts",
    "smoke:fixture": "node scripts/real-fixture-smoke.ts",
    "mcp:serve": "node src/mcp/stdio.ts",
    "web:build": "vite build --config src/web/vite.config.ts",
    "web:dev": "vite --config src/web/vite.config.ts",
    "web:preview": "vite preview --config src/web/vite.config.ts",
    "test": "node --test tests/**/*.test.ts",
    "test:coverage": "node scripts/node-coverage.ts",
    "test:e2e": "pnpm web:build && playwright test"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.8",
    "@earendil-works/pi-agent-core": "0.84.1",
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@earendil-works/pi-session-backend-sqlite-node": "0.84.1",
    "@langchain/langgraph": "1.4.9",
    "@langchain/langgraph-checkpoint": "1.1.3",
    "@langchain/langgraph-checkpoint-sqlite": "1.0.3",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@symphoneer/assistant-client": "link:src/assistant-client",
    "@symphoneer/contracts": "link:src/contracts",
    "@symphoneer/mcp": "link:src/mcp",
    "@symphoneer/runtime": "link:src/runtime",
    "@symphoneer/runtime-client": "link:src/runtime-client",
    "@symphoneer/runtime-tools": "link:src/runtime-tools",
    "ansi-to-react": "^6.2.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "liquidjs": "10.28.0",
    "lucide-react": "^1.30.0",
    "motion": "^13.0.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-router-dom": "^7.18.2",
    "shiki": "^3.23.0",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "yaml": "2.9.0",
    "zod": "4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/istanbul-lib-coverage": "^2.0.6",
    "@types/istanbul-lib-report": "^3.0.3",
    "@types/istanbul-reports": "^3.0.4",
    "@types/node": "^22.20.1",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "c8": "^12.0.0",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "v8-to-istanbul": "^9.3.0",
    "vite": "^6.4.3"
  }
}
